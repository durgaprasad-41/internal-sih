MYSQL_DATABASE=examiq
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
DATABASE_URL=jdbc:mysql://mysql:3306/examiq
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
JWT_SECRET=change-me-super-secret-key

# Admin login OTP email. Off by default (MAIL_ENABLED unset/false) - the OTP
# is printed to the backend console instead, so local dev never needs real
# SMTP credentials. To send real emails via Gmail: set MAIL_ENABLED=true,
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME to your Gmail
# address, and MAIL_PASSWORD to a Gmail App Password (Google Account >
# Security > 2-Step Verification > App passwords) - never your normal
# account password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

AI_SERVICE_URL=http://ai-service:8001
FILE_STORAGE_PATH=/app/uploads
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8001
MYSQL_PORT=3306
